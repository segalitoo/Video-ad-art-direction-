__pycache__/
*.pyc
.DS_Store
# Media stays out of git. Keep it in Drive or the asset library;
# the iteration log records where each file lives.
*.mp4
*.mov
*.webm
*.wav
projects/*/clips/
projects/*/exports/
.selftest/

# Raw API downloads; the repo keeps JPEG copies of images (keeps it light)
examples/**/out/*.png

# Exception: the finished ads are the deliverable, and this workspace is temporary
!examples/*/final/deliver/*.mp4

# Third-party references in the taste library: this repo is public
taste/refs/external/

# The art director's own reference images: kept local unless they choose to publish them (public repo)
examples/axolotl/refs/
